# Local docker-compose defaults (Postgres 5433, Redis 6380)
DATABASE_URL=postgresql://codementor:codementor@localhost:5433/codementor
REDIS_URL=redis://localhost:6380
JWT_SECRET=replace-this-with-a-long-random-string
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
RUNNER_IMAGE=codementor-runner:1
# Docker worker on EC2: host path bind-mounted in docker-compose.worker.yml
# JUDGE_TMP_ROOT=/var/codementor-jobs
PORT=4000
WEB_ORIGIN=http://localhost:5173

# Render web service only (production): public URL of the API service, no trailing slash
# API_UPSTREAM=https://codementor-api.onrender.com

# Worker on AWS EC2: DATABASE_URL + REDIS_URL from Render (external URLs); see docs/DEPLOY-AWS.md
# Production deploy guide: docs/DEPLOY.md
